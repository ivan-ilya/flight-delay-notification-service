# Data source: set to "true" to use real TUI Flights API, otherwise uses mock data
USE_TUI_API=false

# TUI Flights MCP API credentials
TUI_API_URL=https://dwzlz974ba.execute-api.eu-west-2.amazonaws.com/prod/flights
TUI_API_KEY=your-tui-api-key-here

# Polling configuration
POLLING_INTERVAL_MS=30000
WARNING_THRESHOLD_MINUTES=15
CRITICAL_THRESHOLD_MINUTES=60
COOLDOWN_MINUTES=10
NOTIFY_ON_RESOLVE=true

# Flights to track (comma-separated TUI flight numbers, e.g. TOM1234,TOM2456)
TRACKED_FLIGHTS=TOM1234,TOM1235,TOM2456

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
